# Rebuild application code using an already verified local runtime image.
# Tag the verified image locally and supply that reference with --build-arg.
ARG RUNTIME_BASE_IMAGE=frigate-uploader:runtime-base
FROM ${RUNTIME_BASE_IMAGE}
WORKDIR /app
RUN command -v ffprobe && rm -f /app/.env
COPY main.py requirements.txt ./
COPY src/ ./src/
COPY db/migrations/ ./db/migrations/
COPY tests/ ./tests/
CMD ["python", "main.py"]
